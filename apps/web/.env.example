# Public CDN URL for the exclusive LAMBTECH Space. This is the only media
# configuration needed by the frontend. Do not add access keys, backend tokens,
# database URLs, or any other credentials.
NEXT_PUBLIC_MEDIA_BASE_URL=
# In Vercel, set this explicitly to "production" in the Production environment
# for the live lambtech.us deployment, then redeploy. Preview and QA deployments
# must keep another value (or leave it unset); they emit noindex metadata and a
# blocking robots.txt. The API is deployed separately on DigitalOcean.
NEXT_PUBLIC_SITE_ENV=development
# Public API base URL, including the version prefix. No secrets belong here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
