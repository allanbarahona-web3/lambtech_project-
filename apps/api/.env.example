# Server-only configuration. Populate only local or deployment-specific values;
# never commit credentials. This file deliberately carries variable names only.
NODE_ENV=
PORT=
PUBLIC_WEB_ORIGINS=
PUBLIC_LEAD_SOURCE_SITE_ORIGINS=
TRUST_PROXY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_NOTIFICATION_TO=

# Optional runtime tuning.
PUBLIC_LEAD_RATE_LIMIT_MAX_ATTEMPTS=
PUBLIC_LEAD_RATE_LIMIT_WINDOW_SECONDS=
LEAD_EMAIL_WORKER_POLL_INTERVAL_MS=
LEAD_EMAIL_WORKER_LEASE_SECONDS=
LEAD_EMAIL_WORKER_SEND_TIMEOUT_MS=
LEAD_EMAIL_WORKER_SHUTDOWN_TIMEOUT_MS=
LEAD_EMAIL_WORKER_MAX_ATTEMPTS=
LEAD_VISITOR_CONFIRMATION_MAX_PER_RECIPIENT=
LEAD_VISITOR_CONFIRMATION_WINDOW_SECONDS=

# Local/integration-test controls. Do not configure these in production.
PUBLIC_LEAD_LOCAL_INTEGRATION=
LEAD_OUTBOX_POSTGRES_INTEGRATION=
LEAD_OUTBOX_TEST_DATABASE_URL=
